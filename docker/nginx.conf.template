# Rendered by the nginx image at start; only ${INVIDIOUS_*} and ${NGINX_LOCAL_RESOLVERS} are filled in.
server {
    listen 8080;
    root /usr/share/nginx/html;

    location = /config.json {
        default_type application/json;
        add_header Cache-Control "no-store";
        return 200 '{ "invidiousUrl": "${INVIDIOUS_PUBLIC_URL}" }';
    }

    # Watch positions, kept by the small server in this container (server/main.mjs).
    location /invi-api/ {
        proxy_pass http://127.0.0.1:8081;
    }

    # Everything Invidious serves, proxied so the app and its token stay on one origin.
    # Channel pictures and banners straight from Google's image server, as Invidious' /ggpht/ would:
    # since Invidious v2.20261103.0 its "/:user/:tab" route catches most of them
    # (https://github.com/iv-org/invidious/issues/6125). The browser still only talks to this server.
    location ^~ /ggpht/ {
        resolver ${NGINX_LOCAL_RESOLVERS} ipv6=off valid=300s;
        set $ggpht https://yt3.ggpht.com;
        rewrite ^/ggpht/(.*)$ /$1 break;
        proxy_pass $ggpht;
        proxy_set_header Host yt3.ggpht.com;
        proxy_set_header Cookie "";
        proxy_hide_header Set-Cookie;
        proxy_ssl_server_name on;
        proxy_ssl_name yt3.ggpht.com;
        add_header Cache-Control "public, max-age=86400";
    }

    # Through Docker's DNS and over IPv4 only: Invidious listens on IPv4 alone, so an IPv6 address
    # for it is refused first. Looking the name up as it goes also follows a restarted container.
    location ~ ^/(api|companion|vi|ggpht|sb|videoplayback)(/|$) {
        resolver ${NGINX_LOCAL_RESOLVERS} ipv6=off valid=30s;
        set $invidious ${INVIDIOUS_URL};
        proxy_pass $invidious;
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    location ~* \.(js|css|svg|woff2?)$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
